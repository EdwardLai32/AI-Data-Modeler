{#-
  Standalone HTML report. Everything is inline — CSS, chart images as data URIs —
  so the file renders identically from a filesystem path, an email attachment, or
  a static bucket, with no network access.
-#}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
*, *::before, *::after { box-sizing: border-box; }
:root {
  color-scheme: light;
  {{ css_vars }}
}
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--surface-page);
  color: var(--text-primary);
  font-family: var(--font-stack);
  font-size: 16px;
  line-height: 1.62;
}
a { color: #256abf; }
.layout {
  display: grid;
  grid-template-columns: 268px minmax(0, 1fr);
  gap: 40px;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 28px 96px;
}
/* Sticky table of contents: the report is long, and a reader who scrolls into
   section 6 needs to be able to leave it without scrolling back. */
aside.toc {
  position: sticky;
  top: 0;
  align-self: start;
  max-height: 100vh;
  overflow-y: auto;
  padding: 32px 0 32px;
  font-size: 13.5px;
}
aside.toc .toc-label {
  text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px;
  color: var(--text-muted); margin: 0 0 10px;
}
aside.toc ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; }
aside.toc li { counter-increment: toc; margin: 0 0 2px; }
aside.toc a {
  display: block; padding: 5px 10px 5px 30px; border-radius: 6px;
  color: var(--text-secondary); text-decoration: none; position: relative;
}
aside.toc a::before {
  content: counter(toc); position: absolute; left: 8px;
  color: var(--text-muted); font-variant-numeric: tabular-nums; font-size: 12px;
}
aside.toc a:hover { background: var(--surface-1); color: var(--text-primary); }
main { padding: 32px 0 0; min-width: 0; }
header.masthead { border-bottom: 1px solid var(--grid); padding-bottom: 26px; }
.eyebrow {
  text-transform: uppercase; letter-spacing: 0.08em; font-size: 11.5px;
  color: var(--text-muted); margin: 0 0 8px;
}
h1 { font-size: 34px; line-height: 1.18; margin: 0 0 8px; font-weight: 660; letter-spacing: -0.01em; }
h2 {
  font-size: 23px; margin: 52px 0 12px; font-weight: 620;
  padding-top: 8px; scroll-margin-top: 18px;
}
h3 { font-size: 17.5px; margin: 30px 0 8px; font-weight: 620; }
h4 { font-size: 15.5px; margin: 22px 0 6px; font-weight: 620; color: var(--text-secondary); }
p { margin: 0 0 14px; max-width: 74ch; }
.subtitle { font-size: 18px; color: var(--text-secondary); margin: 0 0 12px; max-width: 74ch; }
.byline { font-size: 13.5px; color: var(--text-muted); margin: 0; }
.tiles {
  display: grid; gap: 12px; margin: 26px 0 8px;
  grid-template-columns: repeat(auto-fit, minmax(166px, 1fr));
}
.tile { background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
.tile-label { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
.tile-value { font-size: 25px; font-weight: 640; margin-top: 2px; }
.tile-note { font-size: 12px; color: var(--text-secondary); }
.callout {
  background: var(--surface-1); border: 1px solid var(--border);
  border-left: 3px solid var(--series-1); border-radius: 8px;
  padding: 18px 22px; margin: 0 0 8px;
}
.callout p:last-child { margin-bottom: 0; }
.prose ul, .prose ol { max-width: 74ch; padding-left: 22px; }
.prose li { margin-bottom: 4px; }
.prose code {
  background: var(--surface-1); border: 1px solid var(--border); border-radius: 4px;
  padding: 1px 5px; font-size: 0.88em;
}
.prose pre {
  background: var(--surface-1); border: 1px solid var(--border); border-radius: 8px;
  padding: 14px 16px; overflow-x: auto; font-size: 13px;
}
.prose pre code { border: 0; padding: 0; background: none; }
.prose blockquote {
  margin: 0 0 14px; padding: 2px 0 2px 16px; border-left: 3px solid var(--baseline);
  color: var(--text-secondary);
}
table {
  border-collapse: collapse; width: 100%; margin: 6px 0 20px; font-size: 14px;
}
th, td {
  text-align: left; vertical-align: top; padding: 8px 14px 8px 0;
  border-bottom: 1px solid var(--grid); font-variant-numeric: tabular-nums;
}
th { color: var(--text-muted); font-weight: 600; white-space: nowrap; }
td.wrap { font-variant-numeric: normal; }
figure { margin: 22px 0; }
figure img {
  display: block; width: 100%; height: auto; border: 1px solid var(--border);
  border-radius: 10px; background: var(--surface-1);
}
figcaption { font-size: 13px; color: var(--text-secondary); margin-top: 8px; max-width: 82ch; }
figcaption a { color: #256abf; }
.chart-missing {
  border: 1px solid var(--border); border-radius: 10px; padding: 14px 18px;
  background: var(--surface-1); font-size: 13.5px; color: var(--text-secondary);
}
.pill {
  display: inline-block; font-size: 12px; padding: 2px 9px; border-radius: 999px;
  border: 1px solid var(--border); color: var(--text-secondary); margin-left: 8px;
  vertical-align: middle;
}
.pill.good { color: #006300; border-color: #0ca30c; }
.pill.bad { color: #d03b3b; border-color: #d03b3b; }
footer.colophon {
  margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--grid);
  color: var(--text-muted); font-size: 13px;
}
@media (max-width: 900px) {
  .layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
  aside.toc { position: static; max-height: none; padding-bottom: 8px; }
}
@media print {
  body { background: #fff; font-size: 11.5pt; }
  .layout { display: block; padding: 0; max-width: none; }
  aside.toc { display: none; }
  h2 { break-after: avoid; }
  figure, table { break-inside: avoid; }
}
</style>
</head>
<body>
<div class="layout">
<aside class="toc">
  <p class="toc-label">Contents</p>
  <ol>
    {%- for item in toc %}
    <li><a href="#{{ item.anchor }}">{{ item.title }}</a></li>
    {%- endfor %}
  </ol>
</aside>
<main>
<header class="masthead">
  <p class="eyebrow">AutoML Architect · {{ project }}</p>
  <h1>{{ report_title }}</h1>
  {%- if subtitle %}
  <p class="subtitle">{{ subtitle }}</p>
  {%- endif %}
  <p class="byline">Run <code>{{ run_id }}</code> · generated {{ generated }}
    {%- if grade %} · grade {{ grade }}
    <span class="pill {{ 'good' if acceptable else 'bad' }}">
      {{ 'recommended' if acceptable else 'not recommended' }}</span>
    {%- endif %}
  </p>
  {%- if metrics %}
  <div class="tiles">
    {%- for metric in metrics %}
    <div class="tile">
      <div class="tile-label">{{ metric.label }}</div>
      <div class="tile-value">{{ metric.value }}</div>
      {%- if metric.note %}<div class="tile-note">{{ metric.note }}</div>{% endif %}
    </div>
    {%- endfor %}
  </div>
  {%- endif %}
</header>

<h2 id="executive-summary">Executive summary</h2>
<div class="callout prose">{{ executive_summary }}</div>

{%- if dashboard_href %}
<p><a href="{{ dashboard_href }}">Open the interactive dashboard →</a></p>
{%- endif %}

{%- for section in sections %}
<h2 id="{{ section.anchor }}">{{ section.heading }}</h2>
<div class="prose">{{ section.body }}</div>
  {%- for chart in section.charts %}
  <figure>
    {%- if chart.src %}
    <img src="{{ chart.src }}" alt="{{ chart.title }}">
    {%- else %}
    <div class="chart-missing">No image was exported for <strong>{{ chart.title }}</strong>.</div>
    {%- endif %}
    <figcaption><strong>{{ chart.title }}</strong>{% if chart.caption %} — {{ chart.caption }}{% endif %}
      {%- if chart.href %} <a href="{{ chart.href }}">interactive version</a>{% endif %}
    </figcaption>
  </figure>
  {%- endfor %}
{%- endfor %}

<h2 id="charts">Charts</h2>
{%- if orphan_charts %}
<p>Charts not referenced by a section above.</p>
  {%- for chart in orphan_charts %}
  <figure>
    {%- if chart.src %}
    <img src="{{ chart.src }}" alt="{{ chart.title }}">
    {%- else %}
    <div class="chart-missing">No image was exported for <strong>{{ chart.title }}</strong>.
      {%- if chart.href %} <a href="{{ chart.href }}">Open the interactive version</a>.{% endif %}</div>
    {%- endif %}
    <figcaption><strong>{{ chart.title }}</strong>{% if chart.caption %} — {{ chart.caption }}{% endif %}
      {%- if chart.href %} <a href="{{ chart.href }}">interactive version</a>{% endif %}
    </figcaption>
  </figure>
  {%- endfor %}
{%- elif not sections %}
<p>No charts were rendered for this run.</p>
{%- else %}
<p>Every rendered chart appears with the section that references it.</p>
{%- endif %}
{%- if skipped_charts %}
<h3>Charts that could not be rendered</h3>
<table>
  <thead><tr><th>Chart</th><th>Kind</th><th>Reason</th></tr></thead>
  <tbody>
  {%- for chart in skipped_charts %}
    <tr><td>{{ chart.title }}</td><td>{{ chart.kind }}</td><td class="wrap">{{ chart.error }}</td></tr>
  {%- endfor %}
  </tbody>
</table>
{%- endif %}

<h2 id="deployment">Deployment recommendation</h2>
<table>
  <tbody>
  {%- for row in deployment_rows %}
    <tr><th>{{ row.0 }}</th><td class="wrap">{{ row.1 }}</td></tr>
  {%- endfor %}
  </tbody>
</table>
{%- if monitoring_plan %}
<h4>Monitoring plan</h4>
<ul class="prose">{% for item in monitoring_plan %}<li>{{ item }}</li>{% endfor %}</ul>
{%- endif %}
{%- if deployment_risks %}
<h4>Risks</h4>
<ul class="prose">{% for item in deployment_risks %}<li>{{ item }}</li>{% endfor %}</ul>
{%- endif %}

<h2 id="leaderboard">Model leaderboard</h2>
<table>
  <thead><tr>{% for cell in leaderboard_header %}<th>{{ cell }}</th>{% endfor %}</tr></thead>
  <tbody>
  {%- for row in leaderboard_rows %}
    <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
  {%- endfor %}
  </tbody>
</table>

<h2 id="decision-log">Decision log</h2>
<p>Every choice an agent made, with the reason it gave, reproduced verbatim.</p>
<table>
  <thead><tr><th>Agent</th><th>Decision</th><th>Rationale</th></tr></thead>
  <tbody>
  {%- for decision in decisions %}
    <tr>
      <td>{{ decision.agent }}</td>
      <td class="wrap">{{ decision.decision }}</td>
      <td class="wrap">{{ decision.rationale }}</td>
    </tr>
  {%- endfor %}
  </tbody>
</table>

<h2 id="run-metadata">Run metadata</h2>
<table>
  <tbody>
  {%- for row in metadata_rows %}
    <tr><th>{{ row.0 }}</th><td class="wrap">{{ row.1 }}</td></tr>
  {%- endfor %}
  </tbody>
</table>

<h2 id="usage">Usage and cost</h2>
<table>
  <tbody>
  {%- for row in usage_rows %}
    <tr><th>{{ row.0 }}</th><td>{{ row.1 }}</td></tr>
  {%- endfor %}
  </tbody>
</table>

{%- if appendix_notes or warnings %}
<h2 id="notes">Notes and warnings</h2>
{%- if appendix_notes %}
<ul class="prose">{% for note in appendix_notes %}<li>{{ note }}</li>{% endfor %}</ul>
{%- endif %}
{%- if warnings %}
<h4>Run warnings</h4>
<ul class="prose">{% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
{%- endif %}
{%- endif %}

<footer class="colophon">
  Generated by AutoML Architect. Every number in this report was computed by the
  execution layer from this run's own data; every rationale was recorded by the
  agent that made the decision.
</footer>
</main>
</div>
</body>
</html>
