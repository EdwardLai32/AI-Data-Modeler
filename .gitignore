.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/
.cache

# --- notebooks ---------------------------------------------------------------
.ipynb_checkpoints/

# --- frontend ----------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel

# --- editors and OS ---------------------------------------------------------
.idea/
.vscode/
