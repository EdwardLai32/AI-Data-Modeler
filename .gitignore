*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- scratch ----------------------------------------------------------------
# Probe and smoke scripts used while building; not part of the package.
probe_*.py
_smoke*.py
scratch_*.py
_selftest_*.py
scratch/
tmp/
*.log

# --- deliberately committed --------------------------------------------------
# The example CSVs are reproducible from examples/generate_datasets.py, but they
# are committed so a fresh clone can run the quickstart without a build step.
!examples/*.csv

# Ad-hoc verification output from scripts/ (see scripts/verify_build.py)
test_results.txt
live_run*.log
