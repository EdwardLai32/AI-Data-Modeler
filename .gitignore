# --- secrets -----------------------------------------------------------------
# Never commit a credential. `.env.example` is the committed template.
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# --- run output --------------------------------------------------------------
# Artifacts, fitted models, charts, reports, and the SQLite database all live
# under the workspace. None of it is source.
workspace/
workspace_test/
runs/
*.db
*.sqlite
*.sqlite3
*.joblib
*.pkl

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- virtualenvs -------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

