# AI Data Modeler — environment configuration
#
# Copy to `.env` and edit. Settings are read from the environment first, then
# from `.env`, then `.env.local`. Everything except the Anthropic credential is
# prefixed `AUTOML_` and maps to a field on `automl_architect.config.Settings`.
#
# Every value below is the default unless noted, so an empty `.env` with only a
# credential set is a working configuration.

# ---------------------------------------------------------------------------
# Credentials  (required unless you run offline — see AUTOML_OFFLINE below)
# ---------------------------------------------------------------------------

# The Anthropic SDK resolves credentials in this order:
#   1. ANTHROPIC_API_KEY
#   2. ANTHROPIC_AUTH_TOKEN
#   3. an OAuth profile written by `ant auth login`
# Any one of them is enough. `amla doctor` tells you which one it found.
ANTHROPIC_API_KEY=

# Run with no model calls and no credentials at all. Every agent falls back to a
# deterministic rule engine that derives its decisions — and its rationales —
# from the measured profile, so a run still cleans, engineers, trains, tunes,
# explains, and reports. What you lose is inference: the rules read statistics,
# not meaning, so they cannot tell you that `last_login_days` is a churn
# precursor. Rule-derived reasoning is tagged `[rule]` wherever it appears.
# Equivalent to `amla run --offline`. Useful for CI, demos, and cost control.
AUTOML_OFFLINE=false

# Point the SDK at a gateway or proxy. Leave unset for the public API.
# ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------
# Model and reasoning
# ---------------------------------------------------------------------------

# Every agent prompt in this package is written and tuned against Opus 5's
# behaviour — adaptive thinking on by default, effort ladder through `max`.
# Changing this is supported but the prompts are not re-tuned for you.
AUTOML_MODEL=claude-opus-5

# Reasoning depth for agents that do not override it: low|medium|high|xhigh|max.
# Agents that shape the run (planner, evaluation) override this upward regardless.
AUTOML_DEFAULT_EFFORT=high

# Output budget per call. On Opus 5 this covers thinking PLUS visible tokens, so
# a value that looks generous for prose can still truncate a deep reasoning pass.
AUTOML_MAX_OUTPUT_TOKENS=16000

# Adaptive thinking. Setting this false clamps effort to `high`, because the API
# rejects disabled thinking above that.
AUTOML_ENABLE_THINKING=true

# Cache breakpoints on the stable prompt prefix (platform preamble + run context).
# With 13 agents per run this is most of the prompt cost. Leave it on.
AUTOML_ENABLE_PROMPT_CACHING=true

# Re-serve a policy decline through Anthropic's recommended fallback model instead
# of failing the run. The substitution is recorded as a warning on the summary.
AUTOML_ENABLE_REFUSAL_FALLBACK=true

AUTOML_LLM_TIMEOUT_SECONDS=600
AUTOML_LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Root for artifacts, models, charts, reports, and the default SQLite database.
# In Docker this is a volume; on a multi-replica deployment it must be shared,
# because artifacts are written here and served from here.
AUTOML_WORKSPACE=./workspace

# Any SQLAlchemy URL. Empty means SQLite under the workspace, which is fine for
# a single process. Use Postgres for anything shared.
#   postgresql+psycopg://automl:automl@localhost:5432/automl
AUTOML_DATABASE_URL=

# ---------------------------------------------------------------------------
# Execution budgets
# ---------------------------------------------------------------------------

# Row cap for the expensive profiling passes (correlations, outliers, leakage).
# The true row count is always reported to the agents; only the statistics sample.
AUTOML_MAX_PROFILE_ROWS=250000

# Row cap before training subsamples.
AUTOML_MAX_TRAIN_ROWS=500000

# sklearn parallelism. -1 uses every core; set it to a number in a container with
# a CPU limit, or joblib will oversubscribe and slow everything down.
AUTOML_N_JOBS=-1

AUTOML_DEFAULT_RANDOM_STATE=42

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# 127.0.0.1 refuses connections from outside the machine. Use 0.0.0.0 in a
# container, and put an authenticating proxy in front of it — the API has no
# authentication of its own.
AUTOML_API_HOST=127.0.0.1
AUTOML_API_PORT=8000

# Origins allowed to call the API from a browser. JSON list.
AUTOML_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

AUTOML_LOG_LEVEL=INFO

# Structured JSON logs, for a log aggregator.
AUTOML_LOG_JSON=false

# Optional MLflow tracking. Empty disables it; mlflow is not installed by default.
AUTOML_MLFLOW_TRACKING_URI=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# The test suite is offline by default. Set both of these to enable the tests
# marked `@pytest.mark.live`, which call the real API and cost money. Neither is a
# `Settings` field — they are read by tests/conftest.py only, and the separate
# key name means an offline test cannot spend against your real credential.
# AUTOML_LIVE_TESTS=1
# ANTHROPIC_API_KEY_LIVE=
